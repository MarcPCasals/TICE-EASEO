rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isEducandUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@educand[.]ad$');
    }

    function isAdmin() {
      return isEducandUser()
        && request.auth.token.email == 'mperezc@educand.ad';
    }

    match /consultations/{consultationId} {
      allow create: if isEducandUser()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'topic',
          'message',
          'resourceId',
          'resourceType',
          'status',
          'createdAt'
        ])
        && request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.topic is string
        && request.resource.data.message is string
        && (!('resourceId' in request.resource.data) || request.resource.data.resourceId is string)
        && (!('resourceType' in request.resource.data) || request.resource.data.resourceType is string);

      allow read, update, delete: if isAdmin();
    }

    match /publications/{publicationId} {
      allow read: if isAdmin()
        || (isEducandUser() && resource.data.status in ['published', 'scheduled']);

      allow create: if isAdmin()
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.status in ['draft', 'published', 'scheduled']
        && request.resource.data.keys().hasOnly([
          'type',
          'typeLabel',
          'title',
          'summary',
          'category',
          'keywords',
          'content',
          'externalUrl',
          'featured',
          'scheduledFor',
          'status',
          'authorName',
          'authorEmail',
          'createdAt',
          'updatedAt',
          'publishedAt'
        ])
        && request.resource.data.type in ['video', 'article', 'prompt', 'template', 'images']
        && request.resource.data.title is string
        && request.resource.data.summary is string
        && request.resource.data.category is string
        && request.resource.data.keywords is list
        && request.resource.data.content is string
        && request.resource.data.externalUrl is string
        && request.resource.data.featured is bool
        && request.resource.data.scheduledFor is string;

      allow update: if isAdmin()
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.status in ['draft', 'published', 'scheduled']
        && request.resource.data.featured is bool
        && request.resource.data.scheduledFor is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'type',
          'typeLabel',
          'title',
          'summary',
          'category',
          'keywords',
          'content',
          'externalUrl',
          'featured',
          'scheduledFor',
          'status',
          'authorName',
          'authorEmail',
          'updatedAt',
          'publishedAt'
        ]);

      allow delete: if isAdmin();
    }

    match /reminders/{reminderId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'title',
          'notes',
          'dueDate',
          'priority',
          'sourceConsultationId',
          'completed',
          'ownerEmail',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.notes is string
        && request.resource.data.dueDate is string
        && request.resource.data.priority in ['high', 'medium', 'low']
        && request.resource.data.sourceConsultationId is string
        && request.resource.data.completed == false;

      allow update: if isAdmin()
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.priority in ['high', 'medium', 'low']
        && request.resource.data.title is string
        && request.resource.data.notes is string
        && request.resource.data.dueDate is string
        && request.resource.data.completed is bool
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'notes',
          'dueDate',
          'priority',
          'completed',
          'completedAt',
          'updatedAt'
        ]);

      allow delete: if isAdmin();
    }

    match /resourceFeedback/{feedbackId} {
      allow read: if isAdmin();

      allow create, update: if isEducandUser()
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'resourceId',
          'resourceTitle',
          'helpful',
          'userEmail',
          'updatedAt'
        ])
        && request.resource.data.resourceId is string
        && request.resource.data.resourceTitle is string
        && request.resource.data.helpful is bool;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
